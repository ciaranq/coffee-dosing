# Neon Postgres pooled connection string (-pooler DSN, transaction mode)
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Shared HS256 secret between Next.js server actions and FastAPI (/api/index.py)
INTERNAL_JWT_SECRET="replace-with-32-byte-hex-secret"

# Clerk Authentication (provisioned via Vercel Marketplace or Clerk Dashboard)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
